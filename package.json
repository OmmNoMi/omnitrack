{
  "name": "omnitrack",
  "version": "1.2.0",
  "private": true,
  "description": "Frontend bundles for OmniTrack (Vue 3 + Frappe UI).",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "test:bundle": "node scripts/test_bundle_and_components.cjs",
    "test:interactions": "node scripts/test_workstation_interactions.cjs",
    "test:fixtures": "python3 -m unittest omnitrack.tests.test_workspace_fixtures -v",
    "test:mutation": "node scripts/run_mutation_tests.cjs",
    "test:axe": "node scripts/test_axe_wcag.cjs",
    "test:js": "node scripts/check_www_js.cjs",
    "test:fast": "npm run test:bundle && npm run test:js && npm run test:fixtures",
    "test": "npm run test:bundle && npm run test:interactions && npm run test:axe && npm run test:js && npm run test:fixtures"
  },
  "dependencies": {
    "frappe-ui": "^0.1.278",
    "lucide-vue-next": "^0.469.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
}
