{
  "doctype": "DocType",
  "name": "OmniTrack Shift Template",
  "module": "OmniTrack",
  "autoname": "field:shift_name",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "shift_name",
      "fieldtype": "Data",
      "label": "Shift Template Name",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "shift_type",
      "fieldtype": "Select",
      "options": "Split\nSingle\nFlexible\n24x7 Continuous",
      "label": "Shift Architecture Type",
      "default": "Split",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "max_span_hours",
      "fieldtype": "Float",
      "label": "Maximum Daily Span (Hours)",
      "default": 16.0,
      "description": "Max allowed span between earliest session start and latest session punch out."
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description & Operational Rules"
    },
    {
      "fieldname": "sb_sessions",
      "fieldtype": "Section Break",
      "label": "Shift Sessions (Discontinuous Split Windows)"
    },
    {
      "fieldname": "sessions",
      "fieldtype": "Table",
      "label": "Sessions",
      "options": "OmniTrack Shift Session",
      "reqd": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "OmniTrack Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "OmniTrack Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    },
    {
      "role": "OmniTrack User",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0
    }
  ],
  "icon": "clock"
}