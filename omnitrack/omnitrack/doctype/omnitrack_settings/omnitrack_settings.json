{
  "doctype": "DocType",
  "name": "OmniTrack Settings",
  "module": "OmniTrack",
  "issingle": 1,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "sb_split_shift_attendance",
      "fieldtype": "Section Break",
      "label": "Split-Shift & Attendance Synthesis Engine"
    },
    {
      "fieldname": "enable_split_shift_engine",
      "fieldtype": "Check",
      "label": "Enable Split-Shift Engine",
      "default": 1
    },
    {
      "fieldname": "auto_synthesize_attendance_on_checkin",
      "fieldtype": "Check",
      "label": "Auto Synthesize Daily Attendance on Checkin",
      "default": 1
    },
    {
      "fieldname": "midnight_cutoff_hour",
      "fieldtype": "Time",
      "label": "Midnight Cutoff Hour",
      "default": "04:00:00"
    },
    {
      "fieldname": "cb_attendance_thresholds",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "grace_period_mins",
      "fieldtype": "Int",
      "label": "Grace Period (Minutes)",
      "default": 15
    },
    {
      "fieldname": "min_hours_present",
      "fieldtype": "Float",
      "label": "Minimum Hours for Present",
      "default": 6.0
    },
    {
      "fieldname": "min_hours_half_day",
      "fieldtype": "Float",
      "label": "Minimum Hours for Half Day",
      "default": 3.0
    },
    {
      "fieldname": "sb_features",
      "fieldtype": "Section Break",
      "label": "Feature Switches"
    },
    {
      "fieldname": "enable_desk_stopwatch_hud",
      "fieldtype": "Check",
      "label": "Enable Desk Top-Bar Stopwatch HUD",
      "default": 1
    },
    {
      "fieldname": "enable_split_shifts",
      "fieldtype": "Check",
      "label": "Enable Discontinuous Split Shifts",
      "default": 1
    },
    {
      "fieldname": "enable_pai_engine",
      "fieldtype": "Check",
      "label": "Enable Plan Adherence (PAI) Engine",
      "default": 1
    },
    {
      "fieldname": "enable_variance_tracking",
      "fieldtype": "Check",
      "label": "Enable Task Expectation Variance Tracking",
      "default": 1
    },
    {
      "fieldname": "enable_document_linking",
      "fieldtype": "Check",
      "label": "Enable Dynamic Document & URL Linking",
      "default": 1
    },
    {
      "fieldname": "enable_attachment_sync",
      "fieldtype": "Check",
      "label": "Enable Cross-Site File Attachment Sync",
      "default": 1
    },
    {
      "fieldname": "enable_auto_attendance",
      "fieldtype": "Check",
      "label": "Enable Automated Attendance Synthesis (Legacy)",
      "default": 1
    },
    {
      "fieldname": "enable_client_workspaces",
      "fieldtype": "Check",
      "label": "Enable Client SaaS Workspaces (Subdomain)",
      "default": 1
    },
    {
      "fieldname": "enable_workspace_branding",
      "fieldtype": "Check",
      "label": "Enable Workspace White-Label Branding",
      "default": 1
    },
    {
      "fieldname": "enable_push_notifications",
      "fieldtype": "Check",
      "label": "Enable Web & Mobile Push Notifications",
      "default": 1
    },
    {
      "fieldname": "enable_output_metrics",
      "fieldtype": "Check",
      "label": "Enable Quantitative Output Metrics & Deliverable KPIs",
      "default": 1
    },
    {
      "fieldname": "enable_flow_state_catch_up",
      "fieldtype": "Check",
      "label": "Enable Retroactive Flow-State Catch-Up Logging",
      "default": 1
    },
    {
      "fieldname": "enable_task_switching",
      "fieldtype": "Check",
      "label": "Enable 1-Click Atomic Task Switching",
      "default": 1
    },
    {
      "fieldname": "enable_pairing_sessions",
      "fieldtype": "Check",
      "label": "Enable Collaborative Pairing Sessions & Mirrored Timesheets",
      "default": 1
    },
    {
      "fieldname": "enable_lock_screen_actions",
      "fieldtype": "Check",
      "label": "Enable Lock-Screen Mobile Push Actions (+30m, Still Working, Stop)",
      "default": 1
    },
    {
      "fieldname": "sb_roles_entitlements",
      "fieldtype": "Section Break",
      "label": "Multi-Tier Role & Capability Entitlements"
    },
    {
      "fieldname": "user_entitlements",
      "fieldtype": "Table",
      "label": "Role & User Entitlement Matrix",
      "options": "OmniTrack User Entitlement"
    },
    {
      "fieldname": "sb_timesheet_lifecycle",
      "fieldtype": "Section Break",
      "label": "Global Timesheet Generation & Billing Policies"
    },
    {
      "fieldname": "default_timesheet_mode",
      "fieldtype": "Select",
      "options": "Off\nManual On-Demand\nAuto Draft\nAuto Sync Draft",
      "default": "Auto Sync Draft"
    },
    {
      "fieldname": "default_timesheet_frequency",
      "fieldtype": "Select",
      "options": "Timelog (Per Work Block)\nDaily Consolidated\nWeekly Consolidated\nBi-Weekly Consolidated\nMonthly Consolidated",
      "default": "Daily Consolidated"
    },
    {
      "fieldname": "default_timesheet_aggregation",
      "fieldtype": "Select",
      "options": "Individual User\nConsolidated Project",
      "default": "Individual User"
    },
    {
      "fieldname": "require_manager_pricing_signoff",
      "fieldtype": "Check",
      "label": "Require Manager Pricing Sign-Off Before Submission",
      "default": 1
    },
    {
      "fieldname": "project_timesheet_policies",
      "fieldtype": "Table",
      "label": "Per-Project Timesheet Overrides",
      "options": "OmniTrack Project Policy"
    },
    {
      "fieldname": "sb_temporal_governance",
      "fieldtype": "Section Break",
      "label": "Temporal Governance & Horizon Policies"
    },
    {
      "fieldname": "timesheet_modification_horizon_hours",
      "fieldtype": "Int",
      "label": "Timesheet Modification Horizon (Hours)",
      "default": 48,
      "description": "Hours during which standard users can log or modify timesheets without manager sign-off (e.g. 48 for 2 days, 168 for 1 week)."
    },
    {
      "fieldname": "cb_temporal_governance",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "past_block_lock_grace_hours",
      "fieldtype": "Int",
      "label": "Past Work Block Lock Grace Period (Hours)",
      "default": 24,
      "description": "Grace period in hours after a scheduled block before its plan becomes permanently immutable. Accommodates active night shifts and midnight boundary crossing (e.g. 24 for 1 day, 48 for 2 days)."
    },
    {
      "fieldname": "sb_cross_site_sync",
      "fieldtype": "Section Break",
      "label": "Universal Cross-Site Replication Engine"
    },
    {
      "fieldname": "enable_cross_site_sync",
      "fieldtype": "Check",
      "label": "Enable Cross-Site Task & Timesheet Sync",
      "default": 1
    },
    {
      "fieldname": "enable_site_sync",
      "fieldtype": "Check",
      "label": "Enable Site-to-Site Live Sync",
      "default": 1
    },
    {
      "fieldname": "sync_role_scope",
      "fieldtype": "Select",
      "options": "Master\nSatellite\nPeer",
      "label": "Instance Role Scope",
      "default": "Master"
    },
    {
      "fieldname": "sync_interval_mins",
      "fieldtype": "Int",
      "label": "Sync Interval (Minutes)",
      "default": 15
    },
    {
      "fieldname": "conflict_resolution_strategy",
      "fieldtype": "Select",
      "options": "Source Wins\nTarget Wins\nLatest Timestamp\nManual Review\nField-Level Merge",
      "label": "Conflict Resolution Strategy",
      "default": "Latest Timestamp"
    },
    {
      "fieldname": "remote_deletion_policy",
      "fieldtype": "Select",
      "options": "Mark Status as Cancelled / Archived\nHard Delete\nUnlink Only",
      "default": "Mark Status as Cancelled / Archived"
    },
    {
      "fieldname": "sanitize_billing_rates",
      "fieldtype": "Check",
      "label": "Sanitize Billing & Cost Rates During Sync",
      "default": 1
    },
    {
      "fieldname": "audit_log_retention_days",
      "fieldtype": "Int",
      "label": "Audit Log Retention (Days)",
      "default": 90
    },
    {
      "fieldname": "sb_push_config",
      "fieldtype": "Section Break",
      "label": "Web Push (VAPID) Gateway & Fatigue Prevention"
    },
    {
      "fieldname": "vapid_public_key",
      "fieldtype": "Small Text",
      "label": "VAPID Public Key",
      "read_only": 1
    },
    {
      "fieldname": "vapid_private_key",
      "fieldtype": "Password",
      "label": "VAPID Private Key"
    },
    {
      "fieldname": "silence_push_on_leave",
      "fieldtype": "Check",
      "label": "Silence Push Notifications During Approved Leave",
      "default": 1
    },
    {
      "fieldname": "silence_push_on_ooo",
      "fieldtype": "Check",
      "label": "Silence Push During Explicit Out-of-Office Blocks",
      "default": 1
    },
    {
      "fieldname": "allow_push_during_blank_gaps",
      "fieldtype": "Check",
      "label": "Deliver Push During Unplanned Shift Gaps",
      "default": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1
    },
    {
      "role": "OmniTrack Admin",
      "read": 1,
      "write": 1
    },
    {
      "role": "OmniTrack Manager",
      "read": 1,
      "write": 0
    }
  ],
  "icon": "setting"
}